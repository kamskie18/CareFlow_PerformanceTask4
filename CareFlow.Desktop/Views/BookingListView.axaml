<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CareFlow.Application.ViewModels"
             xmlns:dto="using:CareFlow.Application.DTOs"
             x:Class="CareFlow.Desktop.Views.BookingListView"
             x:DataType="vm:BookingListViewModel">

    <DockPanel Margin="16">

        <Button DockPanel.Dock="Top"
                Content="Refresh Bookings"
                Command="{Binding LoadBookingsCommand}"
                HorizontalAlignment="Left"
                Margin="0,0,0,12"/>

        <Grid ColumnDefinitions="*,*">

            <!-- Booking List -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="50,*,110" Margin="4,0,4,4">
                    <TextBlock Grid.Column="0" Text="ID" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="Patient" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="Date" FontWeight="Bold"/>
                </Grid>
                <Separator DockPanel.Dock="Top" Margin="0,0,0,4"/>
                <ListBox ItemsSource="{Binding Bookings}"
                         SelectedItem="{Binding SelectedBooking}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:BookingSummaryDto">
                            <Grid ColumnDefinitions="50,*,110">
                                <TextBlock Grid.Column="0" Text="{Binding BookingId}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PatientName}"/>
                                <TextBlock Grid.Column="2" Text="{Binding BookingDate}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Booking Detail -->
            <Border Grid.Column="1"
                    BorderBrush="Gray" BorderThickness="1"
                    CornerRadius="4" Padding="12"
                    Margin="8,0,0,0">
                <StackPanel Spacing="8"
                            IsVisible="{Binding SelectedBooking, Converter={x:Static ObjectConverters.IsNotNull}}"
                            x:CompileBindings="False">
                    <TextBlock Text="Booking Details" FontWeight="Bold" FontSize="16"/>
                    <TextBlock>
                        <Run Text="Booking #"/><Run Text="{Binding SelectedBooking.BookingId}"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Patient: "/><Run Text="{Binding SelectedBooking.PatientName}"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Date: "/><Run Text="{Binding SelectedBooking.BookingDate}"/>
                    </TextBlock>
                    <TextBlock Text="Services:" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <ItemsControl ItemsSource="{Binding SelectedBooking.Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="8,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </Grid>
    </DockPanel>
</UserControl>
