<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CareFlow.Application.ViewModels"
        xmlns:views="using:CareFlow.Desktop.Views"
        mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="700"
        x:Class="CareFlow.Desktop.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="CareFlow - Diagnostic Booking Management"
        Width="1050" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F7FAFC">

    <Grid ColumnDefinitions="240,*">

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="#1A202C">
            <DockPanel LastChildFill="True">

                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,16" Spacing="6">
                    <TextBlock Text="CareFlow" FontSize="22" FontWeight="Bold" Foreground="White" LetterSpacing="0.5"/>
                    <TextBlock Text="Diagnostic Department" FontSize="12" Foreground="#A0AEC0"/>
                    <Border Background="#2D3748" Height="1" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- Footer / Status Info -->
                <StackPanel DockPanel.Dock="Bottom" Margin="20" Spacing="4">
                    <Border Background="#2D3748" Height="1" Margin="0,0,0,12"/>
                    <TextBlock Text="PostgreSQL Connected" FontSize="11" Foreground="#48BB78" FontWeight="SemiBold"/>
                    <TextBlock Text="ITSD81 - Performance Task 4" FontSize="10" Foreground="#718096"/>
                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel Spacing="8" Margin="14,12">
                    <Button Content="Service Availability"
                            Command="{Binding ShowAvailabilityCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="14,10"
                            CornerRadius="6"
                            Background="#2D3748"
                            Foreground="#E2E8F0"
                            FontWeight="SemiBold"/>

                    <Button Content="Create Booking"
                            Command="{Binding ShowCreateBookingCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="14,10"
                            CornerRadius="6"
                            Background="#2D3748"
                            Foreground="#E2E8F0"
                            FontWeight="SemiBold"/>

                    <Button Content="Confirmed Bookings"
                            Command="{Binding ShowBookingListCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="14,10"
                            CornerRadius="6"
                            Background="#2D3748"
                            Foreground="#E2E8F0"
                            FontWeight="SemiBold"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Main Body Area with TabControl (Native, rock-solid, zero crash) -->
        <Border Grid.Column="1" Padding="24" Background="#FFFFFF">
            <TabControl SelectedIndex="{Binding SelectedViewIndex}">
                <TabControl.Styles>
                    <!-- Hide top tab headers because sidebar buttons control the tab -->
                    <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                </TabControl.Styles>

                <TabItem>
                    <views:AvailabilityView DataContext="{Binding Availability}"/>
                </TabItem>

                <TabItem>
                    <views:CreateBookingView DataContext="{Binding CreateBooking}"/>
                </TabItem>

                <TabItem>
                    <views:BookingListView DataContext="{Binding BookingList}"/>
                </TabItem>
            </TabControl>
        </Border>

    </Grid>
</Window>
