<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CareFlow.Application.ViewModels"
        xmlns:views="using:CareFlow.Desktop.Views"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
        x:Class="CareFlow.Desktop.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="CareFlow - Diagnostic Booking Management"
        Width="900" Height="650">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#0078D4" Padding="16,10">
            <TextBlock Text="CareFlow — Diagnostic Booking Management"
                       Foreground="White" FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- Tab Control -->
        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="8">

            <TabItem Header="Service Availability">
                <views:AvailabilityView DataContext="{Binding Availability}" />
            </TabItem>

            <TabItem Header="Create Booking">
                <views:CreateBookingView DataContext="{Binding CreateBooking}" />
            </TabItem>

            <TabItem Header="View Bookings">
                <views:BookingListView DataContext="{Binding BookingList}" />
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
